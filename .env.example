# Local review only: development server + loopback requests.
# Uses ignored .data/qr-studio.json; never deploy this as your data source.
QR_LOCAL_PREVIEW=1

# Set these to use Supabase Auth/Postgres. Publishable key is client-safe.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional permanent origin for exported QR links (https://qr.example.com).
# Leave empty for local review; falls back to the browser origin.
NEXT_PUBLIC_QR_SCAN_ORIGIN=

# Set only after the separate public scanner has been deployed and verified.
# Must exactly match NEXT_PUBLIC_QR_SCAN_ORIGIN (HTTPS origin, no trailing slash).
# Keeps Studio protected; disables simulated Books reporting in this deployment.
QR_PUBLIC_SCAN_ORIGIN=

# Server-only scoped credential for the scan gateway. Never use NEXT_PUBLIC_.
# Generate a cryptographically random 32-byte value; deploy only its SHA-256
# verifier into the gateway. See supabase/SETUP.md.
QR_SCAN_GATEWAY_KEY=

# Optional account-free workspace, only on a protected Vercel preview.
# Set these on Vercel's preview environment, not for local development.
# Requires workspace-gateway deployment and Vercel Deployment Protection.
QR_PRIVATE_PREVIEW=
QR_WORKSPACE_GATEWAY_KEY=

# Private Books integration; server-only, preview environment only.
# Set the exact protected Books deployment origin and matching report endpoint.
QR_BOOKS_PREVIEW_ORIGIN=
QR_BOOKS_REPORT_URL=
QR_BOOKS_REPORT_KEY=
QR_BOOKS_PROTECTION_BYPASS=
QR_ATTRIBUTION_SECRET=

# Optional comma-separated email allowlist for dashboard signup/sign-in.
QR_ADMIN_EMAILS=

# Optional direct scan path instead of the scoped gateway. Leave unset normally.
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
