{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --ignore-scripts",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/:path*", "destination": "/api/index" }
  ]
}
